# Lippu Survivor 2026 — Environment variables
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local`.

# Supabase project URL (Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the app, used for absolute OpenGraph/Twitter URLs.
# Example: https://survivor.lippu.app (no trailing slash).
NEXT_PUBLIC_APP_URL=

# Service role key (SERVER-SIDE ONLY — never expose in the browser).
# Used by the backend for automated NFL schedule sync and pick evaluation.
# Settings → API → service_role. Leave empty to skip server-side sync/eval.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that guards the scheduled NFL scores job (`/api/cron/nfl-scores`).
# Send it as `Authorization: Bearer <CRON_SECRET>` from your cron provider
# (Vercel Cron, GitHub Actions, etc.). The route returns 403 when unset.
CRON_SECRET=

# Kushki JS SDK: set to 'true' to tokenize cards against Kushki's test
# environment. Any other value (or unset) enforces production (`inTestEnvironment:
# false`), which is required for live transactions on survivor.lippu.app.
NEXT_PUBLIC_KUSHKI_TEST_MODE=false
